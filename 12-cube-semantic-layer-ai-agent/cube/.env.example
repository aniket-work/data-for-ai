# Cube Core settings for Kestrel Bay Bank (copied to .env by scripts/setup_cube.sh).
# setup_cube.sh also writes a random CUBEJS_API_SECRET and CUBEJS_SQL_PASSWORD into .env (never commit .env).
CUBEJS_DB_TYPE=duckdb
CUBEJS_DB_DUCKDB_DATABASE_PATH=../warehouse/bank.duckdb
CUBEJS_DEV_MODE=false
NODE_ENV=production
CUBEJS_CACHE_AND_QUEUE_DRIVER=memory
CUBEJS_PG_SQL_PORT=15432
CUBEJS_EXTERNAL_DEFAULT=false
CUBEJS_TELEMETRY=false
